{
  "expo": {
    "name": "iReader Pro",
    "slug": "ireader-pro-fresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tushar.ireaderpro2"
    },
    "android": {
      "package": "com.tushar.ireaderpro2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "extra": {
      "eas": {
        "projectId": "3adb3544-2b70-45ee-a494-ec375aeada7b"
      }
    },
    "owner": "jammer999"
  }
}